# Maintainer: Agent-Radar Contributors <team@agent-radar.dev>
_repo="${AGENT_RADAR_REPO:-agent-radar/agent-radar}"
pkgname=agent-radar-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Ultra-lightweight, zero-privilege terminal HUD for AI coding agents"
# Only architectures with verified cryptographic checksums are enabled for binary distribution.
# For ARM/aarch64, build from source using 'agent-radar' (cargo build --release).
arch=('x86_64')
url="https://github.com/${_repo}"
license=('MIT')
provides=('agent-radar')
conflicts=('agent-radar')
source_x86_64=("${url}/releases/download/v${pkgver}/agent-radar-x86_64-unknown-linux-musl")
sha256sums_x86_64=('eb12159a0f611d8ce855b452250139e871abfdf841b72df9a22f02ea0afc4005')

package() {
    install -Dm755 "${srcdir}/agent-radar-${CARCH}-unknown-linux-musl" "${pkgdir}/usr/bin/agent-radar"
}

